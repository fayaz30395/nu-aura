# Production Environment Variables for Railway/Render
# Copy this to Railway's Variables tab or Render's Environment Variables

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_DB_HOST:5432/REPLACE_DB_NAME?sslmode=require
SPRING_DATASOURCE_USERNAME=REPLACE_RUNTIME_DB_USER_WITHOUT_BYPASSRLS
SPRING_DATASOURCE_PASSWORD=REPLACE_STRONG_DB_PASSWORD
RLS_PROBE_FAIL_ON_BYPASS=true
FLYWAY_URL=jdbc:postgresql://REPLACE_DIRECT_DB_HOST:5432/REPLACE_DB_NAME?sslmode=require
FLYWAY_USER=REPLACE_MIGRATION_DB_USER
FLYWAY_PASSWORD=REPLACE_STRONG_MIGRATION_DB_PASSWORD
APP_SCHEDULING_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=https://app.REPLACE_DOMAIN.com
JWT_SECRET=REPLACE_STRONG_JWT_SECRET_MIN_32_CHARS
APP_SECURITY_ENCRYPTION_KEY=REPLACE_BASE64_AES_256_KEY
PROMETHEUS_SCRAPE_TOKEN=REPLACE_PROMETHEUS_SCRAPE_TOKEN
NEXT_PUBLIC_API_URL=https://api.REPLACE_DOMAIN.com/api/v1
NEXT_PUBLIC_ENABLE_WEBSOCKET=true
